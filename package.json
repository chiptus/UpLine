    "@tanstack/router-plugin": "^1.136.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.5.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.9.5",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.1.4",
    "oxlint": "^1.11.1",
    "postcss": "^8.4.47",
    "prettier": "^3.6.2",
    "supabase": "2.70.0",
    "tailwindcss": "^3.4.11",
    "tsx": "^4.20.3",
    "typescript": "^5.5.3",
    "vite": "^7.2.7",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.15"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "prettier --write",
      "bash -c 'pnpm run typecheck'"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  }
}
