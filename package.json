    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.43.0",
    "franc": "^6.2.0",
    "idb": "^8.0.3",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.462.0",
    "marked": "^16.4.2",
    "next-themes": "^0.3.0",
    "papaparse": "^5.6.0",
    "posthog-js": "^1.418.10",
    "react": "^18.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.85.0",
