From 92172d425df68eb64e2f305cb3e5e09f1a2d6250 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 10 Nov 2026 04:56:34 +0000
Subject: [PATCH] ci(e2e): pin e2e runner to ubuntu-26.04 instead of latest

Playwright 1.65 supports 26.04, so the 24.04 pin is no longer needed,
but keep an explicit version rather than ubuntu-latest so image bumps
are deliberate.

UPL-134

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TL8Ypzz6KfPtaWEy6Dr7m7
---
 .github/workflows/e2e-run.yml | 9 ++++-----
 1 file changed, 4 insertions(+), 5 deletions(-)

diff --git a/.github/workflows/e2e-run.yml b/.github/workflows/e2e-run.yml
index c210b7e..96324da 100644
--- a/.github/workflows/e2e-run.yml
+++ b/.github/workflows/e2e-run.yml
@@ -17,11 +17,10 @@ on:
 jobs:
   run:
     timeout-minutes: 60
-    # Pinned: ubuntu-latest moved to 26.04, which this Playwright version can't
-    # install WebKit's system libraries on (`install-deps` prints an error but
-    # exits 0), so every WebKit/Mobile Safari test failed at browser launch.
-    # Unpin once the Playwright version supports the newer image.
-    runs-on: ubuntu-24.04
+    # Explicit version, not ubuntu-latest: a silent image bump to 26.04 once
+    # broke WebKit's system libraries under an older Playwright (`install-deps`
+    # prints an error but exits 0). Bump this deliberately, with Playwright.
+    runs-on: ubuntu-26.04
     env:
       VITE_SUPABASE_URL: http://127.0.0.1:54321
       VITE_SUPABASE_PUBLISHABLE_KEY: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
-- 
2.43.0

